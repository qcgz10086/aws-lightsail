# 注意：以下三项均为必填、无默认值。缺失、为空或是默认值/占位值时，
# 应用启动即拒绝（fail-fast），不会用弱值静默启动。
# 请复制为 .env 后把三项都换成自己的强值。

# 必填：JWT 签名密钥，至少 32 位随机字符串
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-set-a-strong-random-secret-at-least-32-chars

# 必填：Fernet 密钥，用于加密存储 AWS Access Key
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：更换此密钥后，已绑定的 AWS Key 将无法解密，需用户重新绑定
ENCRYPTION_KEY=change-me-generate-with-fernet

# 首次启动时若用户表为空则创建的管理员（仅在提供了 ADMIN_PASSWORD 时创建）
ADMIN_USERNAME=admin
# 必填：强管理员密码，禁止使用默认密码 admin123
ADMIN_PASSWORD=change-me-set-a-strong-admin-password

# SQLite 路径（Docker 内使用 /data 卷）
DATABASE_URL=sqlite:////data/app.db

# 流量采集间隔（分钟）
COLLECT_INTERVAL_MINUTES=60

# 可选：开发时 CORS 来源，逗号分隔；生产由 nginx 同源反代可不填
# CORS_ORIGINS=http://localhost:5173
